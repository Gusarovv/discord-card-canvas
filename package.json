{
  "name": "discord-card-canvas",
  "version": "2.3.2",
  "description": "👾 Canvas-based card generator for Discord bots — welcome, leave, rank & info cards with full customization",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist/",
    "build": "npm run clean && tsc",
    "test": "vitest run --update=none",
    "test:update": "vitest run --update=all",
    "dev:test": "vitest",
    "typecheck": "tsc -p test/tsconfig.json",
    "prepare": "npm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "card",
    "canvas",
    "image",
    "generator",
    "welcome",
    "leave",
    "rank",
    "level",
    "xp",
    "profile",
    "banner",
    "info",
    "progress-bar",
    "bot"
  ],
  "author": "Alex Gusarov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gusarovv/discord-card-canvas.git"
  },
  "homepage": "https://github.com/Gusarovv/discord-card-canvas#readme",
  "bugs": {
    "url": "https://github.com/Gusarovv/discord-card-canvas/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "canvas": "3.2.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "jest-image-snapshot": "^6.5.2",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
