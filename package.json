{
  "name": "discord-card-canvas",
  "version": "2.3.3",
  "description": "Welcome, leave, rank, level-up and info card images for Discord bots, built on node-canvas. Typed builders with custom fonts, colors and backgrounds.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist/",
    "build": "npm run clean && tsc",
    "test": "vitest run --update=none",
    "test:update": "vitest run --update=all",
    "dev:test": "vitest",
    "typecheck": "tsc -p test/tsconfig.json",
    "prepare": "npm run build",
    "playground": "vite playground",
    "playground:build": "tsc -p playground && vite build playground",
    "playground:preview": "vite preview playground"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "discord",
    "discord.js",
    "discordjs",
    "discord-bot",
    "discord-canvas",
    "card",
    "canvas",
    "node-canvas",
    "image",
    "generator",
    "image-generator",
    "welcome",
    "welcome-card",
    "welcome-image",
    "leave",
    "leave-card",
    "goodbye-card",
    "rank",
    "rank-card",
    "rankcard",
    "level",
    "level-up",
    "levelup",
    "level-card",
    "leveling",
    "xp",
    "profile",
    "profile-card",
    "banner",
    "info",
    "progress-bar",
    "bot",
    "typescript"
  ],
  "author": "Alex Gusarov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gusarovv/discord-card-canvas.git"
  },
  "homepage": "https://gusarovv.github.io/discord-card-canvas/",
  "bugs": {
    "url": "https://github.com/Gusarovv/discord-card-canvas/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "canvas": "3.2.3"
  },
  "devDependencies": {
    "@fontsource-variable/exo-2": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "@types/node": "26.6.5",
    "jest-image-snapshot": "^6.5.2",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
